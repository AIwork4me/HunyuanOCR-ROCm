--- /dev/null
+++ b/tests/models/transformers/test_create_attention_instances.py
@@ -0,0 +1,119 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""MLA head-size override gating in `create_attention_instances`.
+
+A Transformers-backend text config carrying vestigial DeepSeek-lineage MLA
+fields (`kv_lora_rank`, `qk_nope_head_dim`, `qk_rope_head_dim`) but NO actual
+MLA attention modules — e.g. HunYuanVL, whose attention is plain GQA over
+`head_dim` — must keep the config-derived GQA head size. The override to
+`qk_nope + qk_rope` applies only when `MLAFuser` modules actually matched,
+i.e. a genuine MLA model running full (non-MLA) attention.
+"""
+
+from types import SimpleNamespace
+
+import pytest
+
+from vllm.model_executor.models.transformers.base import Base
+from vllm.model_executor.models.transformers.fusers import MLAFuser
+
+pytestmark = pytest.mark.cpu_test
+
+GQA_HEAD_DIM = 128
+MLA_QK_HEAD_DIM = 192  # qk_nope_head_dim(128) + qk_rope_head_dim(64)
+
+
+def _hunyuan_like_text_config():
+    from transformers.models.hunyuan_vl.configuration_hunyuan_vl import (
+        HunYuanVLTextConfig,
+    )
+
+    config = HunYuanVLTextConfig(
+        hidden_size=1024,
+        intermediate_size=2048,
+        num_hidden_layers=2,
+        num_attention_heads=16,
+        num_key_value_heads=8,
+        head_dim=GQA_HEAD_DIM,
+        vocab_size=1000,
+    )
+    # Vestigial DeepSeek-lineage fields present in the tencent/HunyuanOCR
+    # checkpoint's text_config; the implementation ignores them (plain GQA).
+    config.kv_lora_rank = 512
+    config.qk_nope_head_dim = 128
+    config.qk_rope_head_dim = 64
+    return config
+
+
+class _ArchConfig:
+    """Homogeneous arch config: every layer index maps to the same object."""
+
+    def __init__(self, head_size):
+        self.head_size = head_size
+
+    def __getitem__(self, layer_idx):
+        return self
+
+
+class _ModelConfigStub:
+    def __init__(self, head_size):
+        self.model_arch_config = _ArchConfig(head_size)
+
+    def get_num_attention_heads(self, parallel_config, arch_config=None):
+        return 16
+
+    def get_num_kv_heads(self, parallel_config, arch_config=None):
+        return 8
+
+
+class _FakeMLAFuser(MLAFuser):
+    """Structurally an MLAFuser match without real projections."""
+
+    def __init__(self):
+        pass
+
+
+class _FakeBackend:
+    """Duck-typed `self` for the unbound `create_attention_instances` call."""
+
+    def __init__(self, text_config, fusers):
+        self.text_config = text_config
+        self.fusers = fusers
+        self.model_config = _ModelConfigStub(head_size=GQA_HEAD_DIM)
+        self.parallel_config = SimpleNamespace(tensor_parallel_size=1)
+        self.pp_group = SimpleNamespace(rank_in_group=0, world_size=1)
+        self.cache_config = None
+        self.quant_config = None
+        self.attn_instances = []
+
+    def _get_attn_cls(self):
+        sink = self.attn_instances
+
+        class _RecordingAttn:
+            def __init__(self, **kwargs):
+                sink.append(kwargs)
+
+        return _RecordingAttn
+
+
+def test_vestigial_kv_lora_rank_keeps_gqa_head_size():
+    backend = _FakeBackend(_hunyuan_like_text_config(), fusers={})
+
+    Base.create_attention_instances(backend)
+
+    assert backend.model_config.model_arch_config.head_size == GQA_HEAD_DIM
+    assert len(backend.attn_instances) == 2  # num_hidden_layers
+    assert all(inst["head_size"] == GQA_HEAD_DIM for inst in backend.attn_instances)
+
+
+def test_matched_mla_modules_still_override_head_size():
+    # A genuine MLA model running full attention keeps the qk_nope+qk_rope
+    # head size; the gating must not change this behavior.
+    backend = _FakeBackend(
+        _hunyuan_like_text_config(),
+        fusers={"model.layers.0.self_attn": _FakeMLAFuser()},
+    )
+
+    Base.create_attention_instances(backend)
+
+    assert backend.model_config.model_arch_config.head_size == MLA_QK_HEAD_DIM
diff --git a/tests/models/transformers/test_get_rope_index_kwargs.py b/tests/models/transformers/test_get_rope_index_kwargs.py
new file mode 100644
index 0000000000..e13a2873a4
--- /dev/null
+++ b/tests/models/transformers/test_get_rope_index_kwargs.py
@@ -0,0 +1,121 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Grid-kwargs compatibility of `MultiModalMixin.get_mrope_input_positions`.
+
+Not every HF `get_rope_index` accepts `image_grid_thw`/`video_grid_thw`
+(HunYuanVL's signature has no `video_grid_thw` parameter), so grid kwargs for
+absent modalities must not be passed as explicit `None`.
+"""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.model_executor.models.transformers.multimodal import MultiModalMixin
+from vllm.multimodal.inputs import MultiModalFeatureSpec, PlaceholderRange
+
+pytestmark = pytest.mark.cpu_test
+
+
+class _FakeKwargsItem:
+    """Duck-types `MultiModalKwargsItem` for `MultiModalFeatureSpec.gather_kwargs`."""
+
+    def __init__(self, **kwargs):
+        self._kwargs = kwargs
+
+    def __contains__(self, key):
+        return key in self._kwargs
+
+    def __getitem__(self, key):
+        return SimpleNamespace(data=self._kwargs[key])
+
+
+def _image_feature(offset, length, **grid_kwargs):
+    return MultiModalFeatureSpec(
+        data=_FakeKwargsItem(**grid_kwargs),
+        modality="image",
+        identifier="image-0",
+        mm_position=PlaceholderRange(offset=offset, length=length),
+    )
+
+
+class _HunYuanStyleModel:
+    """`get_rope_index` signature like HunYuanVL: no `video_grid_thw`."""
+
+    def __init__(self):
+        self.calls = []
+
+    def get_rope_index(
+        self,
+        input_ids,
+        mm_token_type_ids,
+        image_grid_thw=None,
+        attention_mask=None,
+    ):
+        self.calls.append(
+            {
+                "input_ids": input_ids,
+                "mm_token_type_ids": mm_token_type_ids,
+                "image_grid_thw": image_grid_thw,
+            }
+        )
+        seq_len = input_ids.shape[1]
+        positions = torch.zeros(4, 1, seq_len, dtype=input_ids.dtype)
+        delta = torch.zeros(1, 1, dtype=torch.int64)
+        return positions, delta
+
+
+class _QwenStyleModel:
+    """`get_rope_index` signature like Qwen2-VL: both grid kwargs accepted."""
+
+    def __init__(self):
+        self.calls = []
+
+    def get_rope_index(self, input_ids, image_grid_thw=None, video_grid_thw=None):
+        self.calls.append(
+            {
+                "input_ids": input_ids,
+                "image_grid_thw": image_grid_thw,
+                "video_grid_thw": video_grid_thw,
+            }
+        )
+        seq_len = input_ids.shape[1]
+        positions = torch.zeros(3, 1, seq_len, dtype=input_ids.dtype)
+        delta = torch.zeros(1, 1, dtype=torch.int64)
+        return positions, delta
+
+
+def test_hunyuan_style_get_rope_index_gets_no_absent_grid_kwargs():
+    model = _HunYuanStyleModel()
+    feature = _image_feature(offset=2, length=4, image_grid_thw=torch.tensor([1, 4, 4]))
+
+    positions, delta = MultiModalMixin.get_mrope_input_positions(
+        SimpleNamespace(model=model), [1] * 10, [feature]
+    )
+
+    (call,) = model.calls
+    # The failing signature on pristine main: TypeError: ... unexpected
+    # keyword argument 'video_grid_thw'. Present grids are still forwarded.
+    assert "video_grid_thw" not in call
+    assert call["image_grid_thw"].shape == (1, 3)
+    assert call["mm_token_type_ids"] is not None
+    assert positions.shape == (4, 10)
+    assert delta == 0
+
+
+def test_qwen_style_model_receives_present_grids_only():
+    model = _QwenStyleModel()
+    feature = _image_feature(offset=2, length=4, image_grid_thw=torch.tensor([1, 2, 2]))
+
+    positions, _ = MultiModalMixin.get_mrope_input_positions(
+        SimpleNamespace(model=model), [1] * 8, [feature]
+    )
+
+    (call,) = model.calls
+    assert call["image_grid_thw"].shape == (1, 3)
+    # Image-only request: the absent modality's grid is not passed as None
+    # (signatures that lack the parameter stay compatible either way, since
+    # every HF implementation defaults it to None).
+    assert call["video_grid_thw"] is None or "video_grid_thw" not in call
+    assert positions.shape == (3, 8)
