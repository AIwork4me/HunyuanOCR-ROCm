diff --git a/vllm/transformers_utils/config.py b/vllm/transformers_utils/config.py
index 0ed71feb22..74be6efe94 100644
--- a/vllm/transformers_utils/config.py
+++ b/vllm/transformers_utils/config.py
@@ -578,6 +578,51 @@ def thinker_uses_mrope(config: PretrainedConfig) -> bool:
     return uses_mrope(thinker_text_config)
 
 
+def _get_mrope_section(config: PretrainedConfig) -> list[int] | None:
+    rope_parameters = getattr(config, "rope_parameters", None)
+    if rope_parameters is None:
+        return None
+
+    section = rope_parameters.get("mrope_section")
+    if isinstance(section, list) and section:
+        return section
+
+    return None
+
+
+def num_mrope_axes(config: PretrainedConfig) -> int:
+    """Number of multimodal RoPE position axes, i.e. ``len(mrope_section)``.
+
+    Per the transformers modeling rule, ``mrope_section`` controls both the
+    number and order of multimodal RoPE axes, so position buffers must be
+    sized from it instead of being hardcoded to 3 axes. This matters because
+    transformers normalizes legacy XD-RoPE checkpoints (e.g. HunYuanVL's
+    ``rope_scaling.type="xdrope"`` with a 4-entry ``xdrope_section``) into a
+    4-section ``mrope_section``.
+    """
+    for section in (
+        _get_mrope_section(config),
+        _get_mrope_section(config.get_text_config()),
+    ):
+        if section is not None:
+            return len(section)
+
+    thinker_config = getattr(config, "thinker_config", None)
+    thinker_text_config = (
+        getattr(thinker_config, "text_config", None)
+        if thinker_config is not None
+        else None
+    )
+    if thinker_text_config is not None:
+        section = _get_mrope_section(thinker_text_config)
+        if section is not None:
+            return len(section)
+
+    # uses_mrope() implies a mrope_section was found; keep the historical
+    # 3-axis default as a safe fallback anyway.
+    return 3
+
+
 def uses_xdrope_dim(config: PretrainedConfig) -> int:
     """Detect if the model with this config uses XD-ROPE."""
     xdrope_section = getattr(config, "xdrope_section", None)
