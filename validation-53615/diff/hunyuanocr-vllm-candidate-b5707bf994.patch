+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Position-axis count selection for multi-dimensional RoPE (RopeState).
+
+The number of multimodal RoPE position axes must follow the
+transformers-normalized `rope_parameters["mrope_section"]` length: Qwen-style
+3-section M-RoPE stays 3 axes, and XD-RoPE checkpoints that transformers
+normalizes into a 4-section m-RoPE (e.g. HunYuanVL's legacy
+`rope_scaling.type="xdrope"` with `xdrope_section=[16, 16, 16, 16]`) must get
+4 axes. A hardcoded 3-axis buffer silently drops the 4th channel and the HF
+model then rejects the positions ("Expected 4 multimodal RoPE channels").
+"""
+
+import json
+from dataclasses import dataclass
+from typing import ClassVar, Literal
+
+import pytest
+import torch
+
+import vllm.v1.worker.gpu.mm.rope as rope_mod
+from vllm.config import ModelConfig
+from vllm.v1.worker.gpu.mm.rope import get_rope_state
+
+pytestmark = pytest.mark.cpu_test
+
+# Minimal but faithful text configs. `head_dim` is chosen so the sections sum
+# to `head_dim // 2`, which the HunYuanVL config validation requires.
+QWEN_LIKE = {
+    "architectures": ["Qwen2VLForConditionalGeneration"],
+    "model_type": "qwen2_vl",
+    "text_config": {
+        "model_type": "qwen2_vl",
+        "hidden_size": 64,
+        "intermediate_size": 128,
+        "num_attention_heads": 4,
+        "num_key_value_heads": 2,
+        "head_dim": 16,
+        "num_hidden_layers": 2,
+        "vocab_size": 1000,
+        "max_position_embeddings": 1024,
+        "rope_theta": 1000000.0,
+        "rope_scaling": {
+            "type": "mrope",
+            "mrope_section": [2, 2, 4],
+            "rope_theta": 1000000.0,
+        },
+    },
+    "vision_config": {"model_type": "qwen2_vl_vision"},
+}
+
+HUNYUAN_LIKE = {
+    "architectures": ["HunYuanVLForConditionalGeneration"],
+    "model_type": "hunyuan_vl",
+    "dtype": "bfloat16",
+    "text_config": {
+        "model_type": "hunyuan_vl_text",
+        "hidden_size": 64,
+        "intermediate_size": 128,
+        "num_attention_heads": 4,
+        "num_key_value_heads": 2,
+        "head_dim": 32,
+        "num_hidden_layers": 2,
+        "vocab_size": 1000,
+        "max_position_embeddings": 1024,
+        "rope_theta": 10000.0,
+        "rope_scaling": {
+            "alpha": 1000.0,
+            "beta_fast": 32,
+            "beta_slow": 1,
+            "factor": 1.0,
+            "mscale": 1.0,
+            "mscale_all_dim": 1.0,
+            "type": "xdrope",
+            "xdrope_section": [4, 4, 4, 4],
+        },
+    },
+    "vision_config": {"model_type": "hunyuan_vl_vision"},
+}
+
+
+TOKENIZER_LIKE = {
+    "extra_special_tokens": {
+        "image_end_token": "<|hy_img_end|>",
+        "image_start_token": "<|hy_img_start|>",
+        "image_token": "<|hy_img|>",
+        "video_end_token": "<|hy_vid_end|>",
+        "video_start_token": "<|hy_vid_start|>",
+        "video_token": "<|hy_vid|>",
+    },
+    "processor_class": "HunYuanVLProcessor",
+    "tokenizer_class": "PreTrainedTokenizerFast",
+}
+
+
+HUNYUAN_LIKE_PREPROCESSOR = {
+    "do_convert_rgb": True,
+    "do_normalize": True,
+    "do_rescale": True,
+    "do_resize": True,
+    "image_mean": [0.48145466, 0.4578275, 0.40821073],
+    "image_processor_type": "HunYuanVLImageProcessor",
+    "image_std": [0.26862954, 0.26130258, 0.27577711],
+    "max_pixels": 16777216,
+    "merge_size": 2,
+    "min_pixels": 262144,
+    "patch_size": 16,
+    "processor_class": "HunYuanVLProcessor",
+    "resample": 1,
+    "rescale_factor": 0.00392156862745098,
+    "size": {"longest_edge": 4194304, "shortest_edge": 262144},
+    "temporal_patch_size": 1,
+}
+
+
+def _model_config(
+    tmp_path, name: str, raw: dict, preprocessor: dict | None = None
+) -> ModelConfig:
+    model_dir = tmp_path / name
+    model_dir.mkdir()
+    (model_dir / "config.json").write_text(json.dumps(raw))
+    if preprocessor is not None:
+        # Multimodal architectures resolve their image processor and tokenizer
+        # at ModelConfig time, so the fixture needs those sidecar files too.
+        (model_dir / "preprocessor_config.json").write_text(json.dumps(preprocessor))
+        (model_dir / "tokenizer_config.json").write_text(json.dumps(TOKENIZER_LIKE))
+    return ModelConfig(
+        model=str(model_dir), trust_remote_code=True, dtype="bfloat16", seed=0
+    )
+
+
+class _StubMropeModel:
+    """Satisfies the SupportsMRoPE runtime_checkable protocol."""
+
+    supports_mrope: ClassVar[Literal[True]] = True
+
+    def get_mrope_input_positions(self, input_tokens, mm_features):
+        raise NotImplementedError
+
+
+@dataclass
+class _RecordingRopeState:
+    num_dims: int
+    has_delta: bool
+    max_num_reqs: int
+    max_num_tokens: int
+    max_model_len: int
+    device: torch.device
+
+
+def _get_rope_state(model_config: ModelConfig, monkeypatch) -> _RecordingRopeState:
+    monkeypatch.setattr(rope_mod, "RopeState", _RecordingRopeState)
+    state = get_rope_state(
+        model_config,
+        _StubMropeModel(),
+        max_num_reqs=2,
+        max_num_tokens=16,
+        max_model_len=64,
+        device=torch.device("cpu"),
+    )
+    assert state is not None
+    return state
+
+
+def test_rope_state_qwen_style_mrope_keeps_3_axes(tmp_path, monkeypatch):
+    model_config = _model_config(tmp_path, "qwen-like", QWEN_LIKE)
+
+    assert model_config.uses_mrope
+    text_config = model_config.hf_config.get_text_config()
+    assert text_config.rope_parameters["mrope_section"] == [2, 2, 4]
+
+    state = _get_rope_state(model_config, monkeypatch)
+    assert state.num_dims == 3
+    assert state.has_delta
+
+
+def test_rope_state_hunyuan_style_xdrope_gets_4_axes(tmp_path, monkeypatch):
+    model_config = _model_config(
+        tmp_path, "hunyuan-like", HUNYUAN_LIKE, HUNYUAN_LIKE_PREPROCESSOR
+    )
+
+    # Transformers normalized the legacy xdrope fields away, so vLLM must take
+    # the axis count from the normalized mrope_section, not from xdrope fields.
+    assert model_config.uses_mrope
+    assert model_config.uses_xdrope_dim == 0
+    text_config = model_config.hf_config.get_text_config()
+    assert text_config.rope_parameters["mrope_section"] == [4, 4, 4, 4]
+
+    state = _get_rope_state(model_config, monkeypatch)
+    assert state.num_dims == 4
+    assert state.has_delta
