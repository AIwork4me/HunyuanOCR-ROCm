+    } else {
+      if (!partials.defined() || partials.size(0) < z_count ||
+          partials.size(1) < rows || partials.size(2) < size_n) {
+        partials = at::empty({z_count, rows, size_n},
+                             at::TensorOptions().dtype(at::kFloat).device(
+                                 at::Device(at::kCUDA, c10::cuda::current_device())));
+      }
+      scratch = partials;
+    }
+    launch_gemm_q4<T>(a + (long)row0 * size_k, b_q_weight, b_qzeros, b_scales,
+                      b_q_perm, c + (long)row0 * size_n, rows, size_n, size_k,
+                      groups, use_v2_format,
+                      scratch.data_ptr<float>(), stream);
