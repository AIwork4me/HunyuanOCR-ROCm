+  for (int slice = 0; slice < slices_per_block; ++slice) {
+    const int slice_id = blockIdx.z * slices_per_block + slice;
+    if (slice_id >= slices_total) break;
+    const int offset_k = slice_id * BLOCK_KN_SIZE;
+    const int end_k = min(offset_k + BLOCK_KN_SIZE, size_k);
