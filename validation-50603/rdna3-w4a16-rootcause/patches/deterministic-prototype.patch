+// ---------------------------------------------------------------------------
+// Root-cause diagnostic + deterministic prototype entry points.
+// ---------------------------------------------------------------------------
+
+namespace vllm {
+namespace gptq_rdna3 {
+
+// Shared argument validation for the diagnostic/prototype ops below.
+// Mirrors gptq_gemm_rdna3 but intentionally never forwards to the WMMA
+// kernel: the diagnostic/prototype target the scalar split-K path.
+static std::tuple<int, int, int, int, const int*> validate_probe_args(
+    torch::Tensor& a, torch::Tensor& b_q_weight, torch::Tensor& b_qzeros,
+    torch::Tensor& b_scales, torch::Tensor& b_g_idx) {
+  TORCH_CHECK(a.is_cuda() && b_q_weight.is_cuda() && b_qzeros.is_cuda() &&
+                  b_scales.is_cuda(),
+              "all tensors must be CUDA/HIP");
+  TORCH_CHECK(a.dim() == 2, "a must be 2D [M, K]");
+  TORCH_CHECK(b_q_weight.dim() == 2, "b_q_weight must be 2D [K/8, N]");
+  TORCH_CHECK(a.scalar_type() == torch::kBFloat16 ||
+                  a.scalar_type() == torch::kHalf,
+              "a must be half or bfloat16");
+  TORCH_CHECK(a.scalar_type() == b_scales.scalar_type(),
+              "b_scales dtype must match a");
+  int size_m = (int)a.size(0);
+  int size_k = (int)a.size(1);
+  int size_n = (int)b_q_weight.size(1);
+  int groups = (int)b_qzeros.size(0);
+  TORCH_CHECK(b_q_weight.size(0) * 8 == size_k,
+              "b_q_weight first dim must be K/8");
+  TORCH_CHECK(b_scales.size(0) == groups && b_scales.size(1) == size_n,
+              "b_scales shape mismatch");
+  TORCH_CHECK(size_n % 8 == 0, "N must be a multiple of 8");
+  const int* g_idx_ptr = nullptr;
+  if (!b_g_idx.device().is_meta() && b_g_idx.numel() > 0) {
+    TORCH_CHECK(b_g_idx.scalar_type() == torch::kInt32,
+                "b_g_idx must be int32");
+    g_idx_ptr = (const int*)b_g_idx.data_ptr();
   }
+  return {size_m, size_n, size_k, groups, g_idx_ptr};
+}
 
+template <typename T>
+at::Tensor gptq_gemm_rdna3_partials_impl(torch::Tensor a,
+                                         torch::Tensor b_q_weight,
+                                         torch::Tensor b_qzeros,
+                                         torch::Tensor b_scales,
+                                         torch::Tensor b_g_idx,
+                                         bool use_v2_format) {
+  const at::cuda::OptionalCUDAGuard device_guard(device_of(a));
+  auto stream = at::cuda::getCurrentCUDAStream();
+  auto [size_m, size_n, size_k, groups, g_idx_ptr] = validate_probe_args(
+      a, b_q_weight, b_qzeros, b_scales, b_g_idx);
+  const int z_count = (size_k + BLOCK_KN_SIZE - 1) / BLOCK_KN_SIZE;
+  at::Tensor partials =
+      torch::empty({z_count, size_m, size_n},
+                   torch::TensorOptions().dtype(torch::kFloat32).device(a.device()));
+  at::Tensor c = torch::empty({size_m, size_n},
+                              torch::TensorOptions().dtype(a.dtype()).device(a.device()));
+  launch_gemm_q4<T>((const T*)a.data_ptr(), (const uint32_t*)b_q_weight.data_ptr(),
+                    (const uint32_t*)b_qzeros.data_ptr(),
+                    (const T*)b_scales.data_ptr(), g_idx_ptr,
+                    (T*)c.data_ptr(), size_m, size_n, size_k, groups,
+                    use_v2_format, (float*)partials.data_ptr(), stream);
+  return partials;
+}
+
+template <typename T>
+at::Tensor gptq_gemm_rdna3_deterministic_impl(
+    torch::Tensor a, torch::Tensor b_q_weight, torch::Tensor b_qzeros,
+    torch::Tensor b_scales, torch::Tensor b_g_idx, bool use_v2_format) {
+  const at::cuda::OptionalCUDAGuard device_guard(device_of(a));
+  auto stream = at::cuda::getCurrentCUDAStream();
+  auto [size_m, size_n, size_k, groups, g_idx_ptr] = validate_probe_args(
+      a, b_q_weight, b_qzeros, b_scales, b_g_idx);
+  const int z_count = (size_k + BLOCK_KN_SIZE - 1) / BLOCK_KN_SIZE;
+  at::Tensor c = torch::empty({size_m, size_n},
+                              torch::TensorOptions().dtype(a.dtype()).device(a.device()));
+  // Row-tiled so the FP32 split scratch stays bounded (tile <= 64 rows):
+  // scratch_bytes = Z * tile * N * 4 <= 26*64*17664*4 ~= 118 MiB worst layer.
+  // Tiling is sequential over row blocks; each tile's reduction is
+  // fixed-order, so the result is deterministic for any M.
+  constexpr int TILE_M = 64;
+  at::Tensor partials;
+  for (int row0 = 0; row0 < size_m; row0 += TILE_M) {
+    const int rows = std::min(TILE_M, size_m - row0);
+    if (!partials.defined() || partials.size(1) < rows) {
+      partials = torch::empty({z_count, rows, size_n},
+                              torch::TensorOptions().dtype(torch::kFloat32).device(a.device()));
+    }
+    const T* a_t = (const T*)a.data_ptr() + (long)row0 * size_k;
+    T* c_t = (T*)c.data_ptr() + (long)row0 * size_n;
+    launch_gemm_q4<T>(a_t, (const uint32_t*)b_q_weight.data_ptr(),
+                      (const uint32_t*)b_qzeros.data_ptr(),
+                      (const T*)b_scales.data_ptr(), g_idx_ptr, c_t, rows,
+                      size_n, size_k, groups, use_v2_format,
+                      (float*)partials.data_ptr(), stream);
+    const long total = (long)rows * size_n;
+    const int threads = 256;
+    const int blocks = (int)((total + threads - 1) / threads);
+    reduce_partials_rdna3<T><<<blocks, threads, 0, stream>>>(
+        (const float*)partials.data_ptr(), c_t, z_count, rows, size_n);
+  }
   return c;
 }
+
+}  // namespace gptq_rdna3
+}  // namespace vllm
+
+torch::Tensor gptq_gemm_rdna3_partials(torch::Tensor a, torch::Tensor b_q_weight,
+                                       torch::Tensor b_qzeros,
+                                       torch::Tensor b_scales,
+                                       torch::Tensor b_g_idx,
+                                       bool use_v2_format) {
+  if (a.scalar_type() == torch::kHalf) {
+    return vllm::gptq_rdna3::gptq_gemm_rdna3_partials_impl<half>(
+        a, b_q_weight, b_qzeros, b_scales, b_g_idx, use_v2_format);
+  }
+  return vllm::gptq_rdna3::gptq_gemm_rdna3_partials_impl<vllm::gptq_rdna3::bf16_t>(
+      a, b_q_weight, b_qzeros, b_scales, b_g_idx, use_v2_format);
+}
+
+torch::Tensor gptq_gemm_rdna3_deterministic(torch::Tensor a,
+                                            torch::Tensor b_q_weight,
+                                            torch::Tensor b_qzeros,
+                                            torch::Tensor b_scales,
+                                            torch::Tensor b_g_idx,
+                                            bool use_v2_format) {
+  if (a.scalar_type() == torch::kHalf) {
+    return vllm::gptq_rdna3::gptq_gemm_rdna3_deterministic_impl<half>(
+        a, b_q_weight, b_qzeros, b_scales, b_g_idx, use_v2_format);
+  }
+  return vllm::gptq_rdna3::gptq_gemm_rdna3_deterministic_impl<
+      vllm::gptq_rdna3::bf16_t>(a, b_q_weight, b_qzeros, b_scales, b_g_idx,
+                                use_v2_format);
+}
