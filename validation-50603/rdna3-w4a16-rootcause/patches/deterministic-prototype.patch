+    outs = [
+        torch.ops._rocm_C.gptq_gemm_rdna3(x, w_q, w_zp, w_s, w_g_idx, False)
+        for _ in range(REPEATS)
+    ]
+    for o in outs[1:]:
+        assert torch.equal(o, outs[0])
