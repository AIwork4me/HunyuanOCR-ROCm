+def _mrope_num_dims_from_config(hf_config) -> int:
+    """Match the HF modeling rule: position axes == len(mrope_section)."""
+    rope_parameters = getattr(hf_config.get_text_config(), "rope_parameters", None)
+    if not isinstance(rope_parameters, dict):
+        return 3
+    candidates: list[dict] = [rope_parameters]
+    candidates += [v for v in rope_parameters.values() if isinstance(v, dict)]
+    for params in candidates:
+        section = params.get("mrope_section")
+        if isinstance(section, list) and section:
+            return len(section)
+    return 3
+
+
 def get_rope_state(
